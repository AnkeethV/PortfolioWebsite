# Database connection string (Postgres / Neon / Vercel Postgres)
# Leave blank for local testing with embedded PGlite WASM Postgres
DATABASE_URL=

# Groq API Key for AI Chatbot inference
GROQ_API_KEY=your_groq_api_key_here

# Admin Portal Authentication
ADMIN_PASSWORD=change_this_to_a_secure_admin_password
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long

# Contact form email delivery (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_EMAIL=ankeeth.v@gmail.com

# Optional local server port
PORT=3000
